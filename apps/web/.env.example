# Gavel web app: local Next.js development.
# Copy to .env.local and replace the placeholders. For the Docker Compose
# stacks use the .env in the repository root instead (see ../../.env.example).

# ─── Database (for example docker-compose.dev.yml, host port 5434) ──
DATABASE_URL=postgresql://immopulse:change-me@localhost:5434/immopulse

# ─── Redis (docker-compose.dev.yml, host port 6380) ───────
REDIS_URL=redis://:change-me@localhost:6380

# ─── Auth.js ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000
# Client IPs from proxy headers are trusted only with TRUST_PROXY_HEADERS=1
# (ideally with TRUST_PROXY_SECRET, which Caddy sends as X-Gavel-Proxy).
# Leave both unset locally.
# TRUST_PROXY_HEADERS=1
# TRUST_PROXY_SECRET=

# ─── MinIO ────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_PUBLIC_URL=http://localhost:9000

# ─── Maps (MapTiler) ──────────────────────────────────────
NEXT_PUBLIC_MAPTILER_KEY=change-me
# Required for server-side geocoding in /api/geo/de/suche. Without it the route
# returns only federal-state matches and never falls back to the public key.
# MAPTILER_SERVER_KEY=change-me

# ─── Error tracking (optional) ────────────────────────────
# Without a DSN the hook does nothing (see instrumentation.ts, lib/sentry.ts).
SENTRY_DSN=

# ─── OpenID Connect (optional) ────────────────────────────
# Active only when fully configured; unknown e-mail addresses are rejected
# (no self-signup).
# AUTH_OIDC_ISSUER=
# AUTH_OIDC_CLIENT_ID=
# AUTH_OIDC_CLIENT_SECRET=
# AUTH_OIDC_NAME=SSO
