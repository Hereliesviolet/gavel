# Gavel environment variables.
# Copy this file to .env and replace every placeholder. Never commit .env.
# See the configuration table in README.md and docs/DEPLOYMENT.md.

# ─── Domain (production, Caddy) ───────────────────────────
# Public domain for which Caddy requests a Let's Encrypt certificate. It must
# have a DNS A record pointing at the server. The host cron scripts in
# scrapers/*.sh also read it to call the app.
DOMAIN=gavel.example.com

# Client IPs are taken from X-Real-IP / a single X-Forwarded-For entry only
# when TRUST_PROXY_HEADERS=1 (the production compose file sets it). Leave it
# unset on staging or dev stacks that expose the app port directly, otherwise
# anyone can evade the login rate limits through X-Forwarded-For.
# Optionally set TRUST_PROXY_SECRET; Caddy forwards it as X-Gavel-Proxy
# (see infra/caddy/Caddyfile) and the app then only trusts requests carrying it.
# TRUST_PROXY_HEADERS=1
# TRUST_PROXY_SECRET=

# ─── Database ─────────────────────────────────────────────
DB_PASSWORD=change-me

# ─── Redis ────────────────────────────────────────────────
REDIS_PASSWORD=change-me

# ─── MinIO (object storage for images and documents) ──────
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
# Base URL only, WITHOUT the bucket path (no trailing "/zvg-images"). The code
# appends the bucket name itself (apps/web/lib/minio.ts getPublicUrl(),
# scrapers/src/storage/minio.py). It has to be reachable from the users'
# browsers; "localhost" does not work in production.
#   dev:  http://localhost:9000
#   prod: https://gavel.example.com (Caddy routes /zvg-images/* to MinIO)
MINIO_PUBLIC_URL=http://localhost:9000

# ─── Auth.js ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me
#   dev:  http://localhost:3000
#   prod: https://gavel.example.com
NEXTAUTH_URL=http://localhost:3000
# Optional. Public origin of the deployment, evaluated when the web image is
# built. Lets next/image and lib/safe-url.ts accept absolute image URLs on the
# own host. In production, set it to the same value as NEXTAUTH_URL.
# NEXT_PUBLIC_SITE_URL=https://gavel.example.com

# ─── AI analysis via Langdock ─────────────────────────────
# API key from your Langdock workspace. The scrapers call Langdock's
# Anthropic-compatible endpoint with the model names below.
LANGDOCK_API_KEY=change-me
LANGDOCK_BASE_URL=https://api.langdock.com/anthropic/eu/
LANGDOCK_MODEL=claude-sonnet-4-6-default
LANGDOCK_EXTRACT_MODEL=claude-haiku-4-5-default
# Daily budget of analyses (daily pipeline) and of the 14:00 backup run.
KI_DAILY_LIMIT=500
KI_BACKUP_LIMIT=400

# ─── Fetching ─────────────────────────────────────────────
# Outbound requests use the honest User-Agent "Gavel/1.0" plus this contact
# (an e-mail address or a project URL) so that site operators can reach you.
# Nominatim's usage policy asks for one as well.
# CONTACT_INFO=ops@example.com
# robots.txt of every target host is honoured. Only switch this off for hosts
# you operate yourself.
# RESPECT_ROBOTS_TXT=true
# Politeness limits for custom-URL fetches (Redis counters)
SCRAPE_MIN_INTERVAL_PER_DOMAIN_SEC=8
SCRAPE_MAX_PER_DOMAIN_HOUR=30
SCRAPE_MAX_GLOBAL_HOUR=60
SCRAPE_COOLDOWN_SECONDS=3600

# Internal URL of the scraper container (not exposed to the host).
SCRAPER_API_URL=http://scraper:8000
# Bearer secret between Next.js (apps/web/app/api/analyse) and the FastAPI
# service in the scraper container. Generate with: openssl rand -base64 32
SCRAPER_API_SECRET=change-me
# Maximum custom-URL analyses per user and 24 hours (cost and abuse control).
ANALYSE_DAILY_LIMIT=25

# ─── Cron / Prefect access to internal API routes ─────────
# Generate with: openssl rand -base64 32
CRON_SECRET=change-me
# Optional audience secrets. Once set, the matching routes accept only that
# secret (no fallback to CRON_SECRET), and the callers (Prefect, host cron,
# Prometheus) have to send the same value.
# CRON_EMAIL_SECRET=
# CRON_OPS_SECRET=
# CRON_JOBS_SECRET=
# METRICS_SECRET=

# ─── E-mail (SMTP) ────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# false = STARTTLS on port 587 (default, try this first). If the provider blocks
# 587, use SMTP_PORT=465 with SMTP_SECURE=true (implicit TLS).
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASSWORD=change-me
SMTP_FROM="Gavel <noreply@example.com>"

# ─── Operations ───────────────────────────────────────────
# Recipient of the daily data-quality report, the freshness alert and the
# Alertmanager notifications (docs/DATA_QUALITY.md).
ADMIN_EMAIL=admin@example.com
# Optional. Shown on the login page as the support contact.
# SUPPORT_EMAIL=support@example.com

# ─── Monitoring (optional override file) ──────────────────
GRAFANA_PASSWORD=change-me
# Optional. Without a DSN the Sentry hooks (web and scrapers) do nothing.
SENTRY_DSN=

# ─── SSO (optional, OpenID Connect) ───────────────────────
# Active only when fully configured. Access stays invitation-based: unknown
# e-mail addresses are rejected.
# AUTH_OIDC_ISSUER=https://login.example.com/tenant/v2.0
# AUTH_OIDC_CLIENT_ID=
# AUTH_OIDC_CLIENT_SECRET=
# AUTH_OIDC_NAME=SSO

# ─── Maps (MapTiler) ──────────────────────────────────────
# The NEXT_PUBLIC_ key is visible in the browser; restrict it by referrer in the
# MapTiler dashboard. The optional server key is used only by
# /api/geo/de/suche and falls back to the public key.
NEXT_PUBLIC_MAPTILER_KEY=change-me
# MAPTILER_SERVER_KEY=change-me

# ─── Docker overrides (optional) ──────────────────────────
# Network of the Prefect server used by docker-compose.prod.yml and the URL
# under which the containers reach it.
# PREFECT_NETWORK=prefect_network
# PREFECT_API_URL=http://prefect-server:4200/api
# Network of an existing reverse proxy (docker-compose.shared-caddy.yml).
# SHARED_CADDY_NETWORK=caddy_network
# Reuse existing volumes instead of creating new ones.
# POSTGRES_VOLUME=
# REDIS_VOLUME=
# MINIO_VOLUME=
